{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:action-flow-ir:schema:0.1.0-draft.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["irVersion", "id", "actions"],
  "properties": {
    "irVersion": {
      "const": "0.1.0-draft.2",
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technology"],
      "properties": {
        "technology": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entryNodeId", "nodes", "connections"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
          },
          "entryNodeId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
                },
                "kind": {
                  "type": "string",
                  "enum": ["start", "end"]
                }
              }
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fromNodeId", "toNodeId"],
              "properties": {
                "fromNodeId": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
                },
                "toNodeId": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
                }
              }
            }
          }
        }
      }
    }
  }
}
