{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "rules",
    "status",
    "diagnostics",
    "allowAdditionalDiagnostics"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": ["valid", "invalid", "tool-error"]
    },
    "allowAdditionalDiagnostics": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["error", "warning"]
          },
          "path": {
            "type": "string",
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
          }
        }
      }
    }
  }
}
